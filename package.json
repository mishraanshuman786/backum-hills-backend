{
  "name": "backum-hills-backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "build": "bun build ./src/server.ts --target=bun --outdir=dist",
    "db:generate": "bunx drizzle-kit generate",
